# ================================================
# 🚀 SUPER STARTER: Шаблон переменных окружения
# Скопируйте в .env.local и заполните значениями
# cp .env.template .env.local
# ================================================

# === 🏗 Infrastructure (Neon / Supabase) ===
# Если Supabase лимиты исчерпаны, используем Neon для БД
DATABASE_URL=
# API Ключ для управления Neon (ветки, базы и т.д.)
NEON_API_KEY=
# Для Supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === 🧠 AI Intelligence (Unkillable Stack) ===
# Основные и резервные провайдеры
GEMINI_API_KEY=
# Резервный ключ Gemini (для автоматического переключения)
GEMINI_API_KEY_SECONDARY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
# OmniRoute AI-шлюз (локально: http://localhost:20128, прод: VPS OmniRoute)
OMNIROUTE_URL=

# === 📺 Content & Social (API Integrations) ===
# YouTube Data API v3 (Extracting transcripts/metadata)
YOUTUBE_API_KEY=
# Telegram Bot API (Notifications / Mini Apps)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 📧 Communications ===
# Resend для транзакционных писем
RESEND_API_KEY=

# === ⚙️ Application Settings ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Секрет для защиты эндпоинтов Vercel Cron
CRON_SECRET=

# === 🛠 Development & Deployment ===
# Используйте фикс-пермишнс если возникают EPERM ошибки
NODE_ENV=development
